# =============================================
# GenomeChat Backend Configuration
# =============================================
# Copy this file to .env and fill in your values
# cp .env.example .env

# --- REQUIRED ---
# Get your key at: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-key-here

# --- DATABASE (auto-configured by docker-compose) ---
# DATABASE_URL=postgresql://genomechat:genomechat@localhost:5432/genomechat

# --- STRONGLY RECOMMENDED ---
# Free, instant, no approval: https://account.ncbi.nlm.nih.gov/settings/
# Raises the NCBI E-utilities cap from 3 to 10 requests/sec. A gene query makes
# ~15 NCBI calls across ClinVar, dbSNP, dbVar, GTR, MedGen, OMIM, PMC and
# PubMed; without a key they queue behind a 2.5/sec limiter and the slowest
# sources start returning nothing at all rather than failing visibly.
# The boot log prints which mode is active.
# NCBI_API_KEY=

# --- OPTIONAL ---
# CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# CACHE_TTL_HOURS=24
# CACHE_MAX_SIZE=1000
# REQUEST_TIMEOUT=30
# LOG_LEVEL=INFO
